{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/.cache/opencode/tmp/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.opencode/skills/**": "allow"
    }
  },
  "model": "sq/gpt-5.6-sol",
  "provider": {
    "emotion": {
      "name": "Emotion Trio",
      "npm": "@ai-sdk/openai",
      "models": {
        "gpt-5.5": {
          "name": "gpt-5.5",
          "options": {
            "store": false,
            "reasoningEffort": "xhigh",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            }
          }
        }
      },
      "options": {
        "baseURL": "https://newapi.pytrio.asia/v1"
      }
    },
    "sq": {
      "name": "swanlab-sq",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://newapi.pytrio.asia/v1"
      },
      "models": {
        "gemini-3.1-pro-high": {
        },
        "grok-4.5": {
          "name": "grok-4.5"
        },
        "glm-5.2": {
            "name": "glm-5.2"
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "options": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            }
          }
        }
      }
    }
  }
}
