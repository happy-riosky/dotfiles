// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      // NERDTree-compatible navigation and open actions.
      "o": "project_panel::OpenPermanent",
      "enter": "project_panel::OpenPermanent",
      "t": "project_panel::OpenPermanent",
      "i": "project_panel::OpenSplitHorizontal",
      "s": "project_panel::OpenSplitVertical",
      "shift-o": "project_panel::ExpandSelectedEntryAndChildren",
      "x": "project_panel::CollapseSelectedEntry",
      "shift-x": "project_panel::CollapseSelectedEntryAndChildren",
      "p": "project_panel::SelectParent",
      "shift-p": "menu::SelectFirst",
      "shift-i": "project_panel::ToggleHideHidden",
      "f": "project_panel::ToggleHideGitIgnore",
      "q": "project_panel::Toggle",
      "shift-a": ["workspace::IncreaseActiveDockSize", { "px": 10000 }],
      "g shift-a": "workspace::ResetActiveDockSize",
      // Zed auto-refreshes; avoid netrw defaults that conflict with NERDTree.
      "shift-d": null,
      "shift-r": null,

      // NERDTree-style file menu operations.
      "m a": "project_panel::NewFile",
      "m shift-a": "project_panel::NewDirectory",
      "m m": "project_panel::Rename",
      "m d": ["project_panel::Trash", { "skip_prompt": false }],
      "m c": "project_panel::Copy",
      "m x": "project_panel::Cut",
      "m p": "project_panel::Paste",

      // Path copy helpers without direct NERDTree equivalents.
      "y r": "workspace::CopyRelativePath",
      "y a": "workspace::CopyPath",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
    "bindings": {
      // Space-based leader mappings
      "space ,": "pane::ActivatePreviousItem",
      "space .": "pane::ActivateNextItem",
      "space 1": ["pane::ActivateItem", 0],
      "space 0": "pane::ActivateLastItem",
      "space w": "workspace::Save",
      "space <": "pane::SwapItemLeft",
      "space >": "pane::SwapItemRight",
      "space t o": "pane::CloseOtherItems",
      "space c": ["editor::ToggleComments", { "advance_downwards": false }],
      "space e": "project_panel::ToggleFocus",
      "space q": "pane::CloseActiveItem",
      "R": "editor::Rename",
      // "space <": [
      //   "workspace::MoveItemToPaneInDirection",
      //   { "direction": "left" },
      // ],
      // "space >": [
      //   "workspace::MoveItemToPaneInDirection",
      //   { "direction": "right" },
      // ],

      // Comma-based leader mappings (Alternative)
      // ", 1": ["pane::ActivateItem", 0],
      // ", 2": ["pane::ActivateItem", 1],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // NERDTree entry point from .vimrc.
      "ctrl-n": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "(vim_mode == normal || vim_mode == helix_normal) && !menu",
    "unbind": {
      "shift-j": "vim::JoinLines",
    },
  },
  {
    "context": "vim_mode == helix_select",
    "unbind": {
      "shift-j": "vim::JoinLines",
    },
  },
  {
    "context": "vim_mode == visual",
    "unbind": {
      "shift-j": "vim::JoinLines",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      // 1. 让 j 和 k 按视觉行移动 (g j / g k)
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
      // 2. 让 J 和 K 一次移动10行 (10 j / 10 k)
      "J": ["workspace::SendKeystrokes", "1 0 j"],
      "K": ["workspace::SendKeystrokes", "1 0 k"],
      // 3. 让 H 和 L 跳转到行首和行尾 (^ / $)
      "H": ["workspace::SendKeystrokes", "^"],
      "L": ["workspace::SendKeystrokes", "$"],
    },
  },
  {
    "context": "Editor && vim_operator == d",
    "bindings": {
      // Keep dj/dk linewise even though normal j/k use display lines.
      "j": "vim::Down",
      "k": "vim::Up",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-shift-g": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "bindings": {
      // Global Ctrl-w leader matching tmux's split and zoom operations.
      "ctrl-w |": "pane::SplitRight",
      "ctrl-w -": "pane::SplitDown",
      "ctrl-w z": "workspace::ToggleZoom",
    },
  },
]
