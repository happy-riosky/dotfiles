#!/usr/bin/env bash
set -euo pipefail

ROOT="${DOTFILES_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
DRY_RUN=0
APP=all

if [[ "${1:-}" == --dry-run ]]; then
  DRY_RUN=1
  shift
fi
if [[ "${1:-}" == --app ]]; then
  APP="${2:-}"
  [[ -n "$APP" ]] || { printf 'plugins: --app requires a value\n' >&2; exit 2; }
  shift 2
fi
[[ $# -eq 0 ]] || { printf 'usage: scripts/plugins [--dry-run] [--app tmux|vim|zsh]\n' >&2; exit 2; }
case "$APP" in all|tmux|vim|zsh) ;; *) printf 'plugins: unsupported app: %s\n' "$APP" >&2; exit 2 ;; esac

apps=(tmux vim zsh)
[[ "$APP" == all ]] || apps=("$APP")
for app in "${apps[@]}"; do
  manifest="$ROOT/plugin-lists/$app.txt"
  [[ -f "$manifest" ]] || { printf 'plugins: missing %s\n' "$manifest" >&2; exit 1; }
  while read -r raw_target repository; do
    [[ -n "$raw_target" && "${raw_target:0:1}" != "#" ]] || continue
    target="${raw_target/#\~/$HOME}"
    if [[ -d "$target/.git" ]]; then
      continue
    fi
    if [[ -e "$target" || -L "$target" ]]; then
      printf 'plugins: target exists and is not a Git checkout: %s\n' "$target" >&2
      exit 1
    fi
    printf 'install %s at %s\n' "$repository" "$target"
    if (( DRY_RUN == 0 )); then
      mkdir -p "$(dirname "$target")"
      git clone "$repository" "$target"
    fi
  done < "$manifest"
done
