#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${DOTFILES_ROOT:-$(cd "$SCRIPT_ROOT/.." && pwd)}"
# shellcheck source=scripts/lib-dotfiles.sh
source "$SCRIPT_ROOT/lib-dotfiles.sh"

PROFILE="${1:-}"
[[ -n "$PROFILE" ]] || { printf 'usage: scripts/packages {full|server|termux} [--dry-run]\n' >&2; exit 2; }
shift

DRY_RUN=0
if [[ "${1:-}" == --dry-run ]]; then
  DRY_RUN=1
  shift
fi
[[ $# -eq 0 ]] || { printf 'packages: unsupported option: %s\n' "$1" >&2; exit 2; }

PLATFORM="$(dotfiles_platform)"
validate_platform_profile "$PLATFORM" "$PROFILE" packages

PACKAGES=()
load_packages() {
  local manifest="$1" package
  [[ -f "$manifest" ]] || { printf 'packages: missing %s\n' "$manifest" >&2; return 1; }
  PACKAGES=()
  while IFS= read -r package || [[ -n "$package" ]]; do
    case "$package" in
      ''|'#'*) continue ;;
    esac
    if [[ ! "$package" =~ ^[[:alnum:]][[:alnum:]@+._/-]*$ ]]; then
      printf 'packages: invalid entry in %s: %s\n' "$manifest" "$package" >&2
      return 1
    fi
    PACKAGES+=("$package")
  done < "$manifest"
  [[ ${#PACKAGES[@]} -gt 0 ]] || { printf 'packages: no packages in %s\n' "$manifest" >&2; return 1; }
}

run_command() {
  printf 'RUN'
  printf ' %s' "$@"
  printf '\n'
  (( DRY_RUN == 1 )) || "$@"
}

require_command() {
  (( DRY_RUN == 1 )) && return 0
  command -v "$1" >/dev/null 2>&1 || {
    printf 'packages: required command not found: %s\n' "$1" >&2
    return 1
  }
}

require_executable() {
  [[ -x "$1" ]] || {
    printf 'packages: required executable not found: %s\n' "$1" >&2
    return 1
  }
}

case "$PLATFORM:$PROFILE" in
  darwin:full)
    load_packages "$ROOT/package-lists/brew-formulae.txt"
    FORMULAE=("${PACKAGES[@]}")
    load_packages "$ROOT/package-lists/brew-casks.txt"
    CASKS=("${PACKAGES[@]}")
    BREW=brew
    if (( DRY_RUN == 0 )); then
      require_command brew
      BREW="$(command -v brew)"
    fi
    run_command "$BREW" install "${FORMULAE[@]}"
    run_command "$BREW" install --cask "${CASKS[@]}"
    ;;
  linux:server)
    load_packages "$ROOT/package-lists/apt.txt"
    APT_GET="${DOTFILES_APT_GET:-/usr/bin/apt-get}"
    (( DRY_RUN == 1 )) || require_executable "$APT_GET"
    APT_PREFIX=()
    if (( EUID == 0 )); then
      run_command "$APT_GET" update
    else
      SUDO="${DOTFILES_SUDO:-/usr/bin/sudo}"
      (( DRY_RUN == 1 )) || require_executable "$SUDO"
      APT_PREFIX=("$SUDO")
      run_command "${APT_PREFIX[@]}" "$APT_GET" update
    fi
    if ! run_command "${APT_PREFIX[@]}" "$APT_GET" install -y "${PACKAGES[@]}"; then
      printf 'packages: batch install failed; retrying packages individually\n' >&2
      failures=0
      for package in "${PACKAGES[@]}"; do
        if ! run_command "${APT_PREFIX[@]}" "$APT_GET" install -y "$package"; then
          printf 'packages: failed to install %s\n' "$package" >&2
          failures=$((failures + 1))
        fi
      done
      (( failures == 0 ))
    fi
    ;;
  termux:termux)
    load_packages "$ROOT/package-lists/termux.txt"
    require_command pkg
    run_command pkg install -y "${PACKAGES[@]}"
    ;;
esac
