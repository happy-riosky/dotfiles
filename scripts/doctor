#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib-dotfiles.sh
source "$SCRIPT_DIR/lib-dotfiles.sh"

ROOT="$(dotfiles_root)"
PLATFORM="$(dotfiles_platform)"
PROFILE="${DOTFILES_PROFILE:-unset}"
FAILURES=0

ok() { printf 'OK: %s\n' "$*"; }
warn() { printf 'WARN: %s\n' "$*" >&2; }
bad() { printf 'FAIL: %s\n' "$*" >&2; FAILURES=$((FAILURES + 1)); }

printf 'platform=%s profile=%s root=%s\n' "$PLATFORM" "$PROFILE" "$ROOT"

while IFS= read -r source_root; do
  while IFS=$'\t' read -r relative source; do
    target="$HOME/$relative"
    if link_matches_source "$target" "$source"; then
      ok "$target"
    else
      bad "$target is not linked to $source"
    fi
  done < <(source_entries "$source_root")
done < <(source_roots "$ROOT" "$PLATFORM")

if [[ "$(git config --global --includes --get http.sslVerify 2>/dev/null || true)" == false ]]; then
  bad 'Git TLS verification is disabled'
else
  ok 'Git TLS verification is enabled'
fi

if [[ -z "$(git config --global --includes --get user.email 2>/dev/null || true)" ]]; then
  bad 'Git local identity is missing'
else
  ok 'Git local identity is available'
fi

while IFS= read -r tracked_file; do
  case "$tracked_file" in
    *.netrc|*/.netrc|*auth.json|*.license|*.bttlicense)
      bad "private file is tracked: $tracked_file"
      ;;
  esac
done < <(git -C "$ROOT" ls-files)

while IFS= read -r -d '' legacy_target; do
  legacy_source="$(readlink "$legacy_target")"
  if [[ "$legacy_source" == "$ROOT/backup" || "$legacy_source" == "$ROOT/backup/"* || \
        "$legacy_source" == "$ROOT/legacy" || "$legacy_source" == "$ROOT/legacy/"* ]]; then
    bad "$legacy_target still points into backup/ or legacy/"
  fi
done < <(find "$HOME" \
  \( -path "$HOME/.cache" -o -path "$HOME/Library/Caches" -o -path "$HOME/.Trash" \
     -o -path "$ROOT" -o -path "$HOME/Library/Group Containers" \
     -o -path "$HOME/Library/Containers" \) -prune -o -type l -print0 2>/dev/null)

KARABINER_SOURCE="$(karabiner_source "$ROOT" "$PLATFORM" || true)"
if [[ -n "$KARABINER_SOURCE" ]]; then
  if link_matches_source "$HOME/.config/karabiner" "$KARABINER_SOURCE"; then
    ok "$HOME/.config/karabiner"
  else
    bad "$HOME/.config/karabiner is not linked to $KARABINER_SOURCE"
  fi
fi

if grep -Eq '^[[:space:]]*(Host|Hostname)[[:space:]]' "$ROOT/home/.ssh/config"; then
  bad 'public SSH config contains host definitions'
else
  ok 'public SSH config is a host-free stub'
fi

if [[ "$PLATFORM" == darwin ]]; then
  for golden in "$ROOT/platforms/darwin/managed/preferences"/*.plist; do
    [[ -e "$golden" ]] || continue
    preference="$HOME/Library/Preferences/$(basename "$golden")"
    [[ -L "$preference" ]] && bad "$preference is a symlink"
  done
  for preference in \
    "$HOME/Library/Preferences/com.apple.symbolichotkeys.plist" \
    "$HOME/Library/Preferences/com.knollsoft.Rectangle.plist"; do
    [[ -L "$preference" ]] && bad "$preference is a symlink"
  done
fi

/bin/bash --noprofile --norc -c 'exit 0' || bad 'clean Bash startup failed'
if [[ -x /bin/zsh ]]; then
  /bin/zsh -f -c 'exit 0' || bad 'clean Zsh startup failed'
fi

(( FAILURES == 0 )) || exit 1
printf 'doctor passed\n'
