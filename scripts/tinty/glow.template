{
  "_tinty_scheme": "{{scheme_id}}",
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "{{base05}}",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "{{base0D}}",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{base0D}}",
    "bold": true
  },
  "h2": {
    "prefix": "## "
  },
  "h3": {
    "prefix": "### "
  },
  "h4": {
    "prefix": "#### "
  },
  "h5": {
    "prefix": "##### "
  },
  "h6": {
    "prefix": "###### ",
    "color": "{{base03}}",
    "bold": false
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "{{base03}}",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "{{base04}}",
    "underline": true
  },
  "link_text": {
    "color": "{{base0C}}",
    "bold": true
  },
  "image": {
    "color": "{{base0E}}",
    "underline": true
  },
  "image_text": {
    "color": "{{base03}}",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "{{base0A}}"
  },
  "code_block": {
    "color": "{{base05}}",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "{{base05}}"
      },
      "error": {
        "color": "{{base08}}"
      },
      "comment": {
        "color": "{{base03}}"
      },
      "comment_preproc": {
        "color": "{{base0F}}"
      },
      "keyword": {
        "color": "{{base0E}}"
      },
      "keyword_reserved": {
        "color": "{{base0E}}"
      },
      "keyword_namespace": {
        "color": "{{base0E}}"
      },
      "keyword_type": {
        "color": "{{base0D}}"
      },
      "name_function": {
        "color": "{{base0D}}"
      },
      "name_class": {
        "color": "{{base0A}}"
      },
      "name_tag": {
        "color": "{{base08}}"
      },
      "literal_string": {
        "color": "{{base0B}}"
      },
      "literal_string_escape": {
        "color": "{{base0C}}"
      },
      "literal_number": {
        "color": "{{base09}}"
      },
      "generic_deleted": {
        "color": "{{base08}}"
      },
      "generic_inserted": {
        "color": "{{base0B}}"
      },
      "background": {
        "background_color": "{{base01}}"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
