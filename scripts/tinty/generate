#!/usr/bin/env bash
# 生成跟随 tinty 的运行时主题产物（读取当前 scheme 的 base16/base24 调色板）：
#   1. yazi flavor：yazi-flavor.template + yazi-tmtheme.template →
#      ~/.config/yazi/flavors/tinty-{dark,light}.yazi/
#   2. glow (glamour) 样式：glow.template →
#      ~/.config/tinted-theming/tinty-glow.json（顶层 _tinty_scheme 标记
#      供调用方校验新鲜度：标记 != current_scheme 时调用方须回退内建样式，
#      绝不渲染过期深浅样式）
#   3. lazygit overlay：lazygit.template →
#      ~/.config/lazygit/tinty.yml（含 _tinty_scheme 标记注释，校验语义
#      同上；槽位语义沿用 catppuccin lazygit yellow 主题）
#   4. gh-dash overlay：gh-dash.template →
#      ~/.config/gh-dash/tinty.yml（纯 theme.colors 片段，标记校验同上）
#      及 ~/.config/gh-dash/tinty-context.yml（repo-context.yml 与主题
#      片段文本拼接——两者顶层键 defaults/theme 不相交，拼接即合法单文档
#      YAML；gh-dash 的 --config 是单槽位 override，无法像 lazygit
#      LG_CONFIG_FILE 叠加多层）
# 均为运行时产物，不入库。由 aliases.sh 的 y()/glow()/lg() 与 gd 启动器
# 在启动前调用（yazi 无 theme 热重载；glow/lazygit/gh-dash 每次调用
# 刷新即可）。
# 无 tinty：yazi flavor 目标缺失时回退拷贝仓库 catppuccin-frappe-lavender
# flavor；glow 样式与 lazygit/gh-dash overlay 保留既有生成结果（陈旧与否
# 由调用方标记校验兜底）。
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/tinted-theming/tinty"
# dark/light 各一份同内容目录：复刻原始 dark/light 双 flavor 结构，
# 同时让终端明暗探测结果无关紧要
flavor_dirs="${XDG_CONFIG_HOME:-$HOME/.config}/yazi/flavors/tinty-dark.yazi ${XDG_CONFIG_HOME:-$HOME/.config}/yazi/flavors/tinty-light.yazi"
glow_style="${XDG_CONFIG_HOME:-$HOME/.config}/tinted-theming/tinty-glow.json"
lazygit_overlay="${XDG_CONFIG_HOME:-$HOME/.config}/lazygit/tinty.yml"
ghdash_dir="${XDG_CONFIG_HOME:-$HOME/.config}/gh-dash"
ghdash_theme="$ghdash_dir/tinty.yml"
ghdash_context="$ghdash_dir/tinty-context.yml"

scheme_id=""
if [ -r "$data_dir/current_scheme" ]; then
  scheme_id="$(tr -d '[:space:]' < "$data_dir/current_scheme")"
  case "$scheme_id" in
    base16-*|base24-*|tinted8-*) ;;
    *) scheme_id="" ;;
  esac
fi

palette_yaml=""
if [ -n "$scheme_id" ]; then
  system="${scheme_id%%-*}"
  slug="${scheme_id#*-}"
  yaml="$data_dir/repos/schemes/$system/$slug.yaml"
  if [ -r "$yaml" ]; then
    palette_yaml="$yaml"
  fi
fi

if [ -z "$palette_yaml" ]; then
  # tinty 不可用：保留既有生成结果；首次则回退仓库 lavender flavor
  first_dir="${flavor_dirs%% *}"
  if [ ! -f "$first_dir/flavor.toml" ]; then
    src_dir="$SCRIPT_DIR/../../home/.config/yazi/flavors/catppuccin-frappe-lavender.yazi"
    for flavor_dir in $flavor_dirs; do
      mkdir -p "$flavor_dir"
      cp "$src_dir/flavor.toml" "$src_dir/tmtheme.xml" "$flavor_dir/"
    done
    printf 'tinty/generate: tinty 不可用，已回退 catppuccin-frappe-lavender\n' >&2
  fi
  exit 0
fi

# 提取 base00..base0F（palette: 块内 "baseXX: "#hex""，容忍引号/尾注释）
pairs="$(grep -E '^[[:space:]]*base[0-9A-Fa-f]{2}[[:space:]]*:' "$palette_yaml" \
  | sed -E 's/^[[:space:]]*base([0-9A-Fa-f]{2})[[:space:]]*:.*#([0-9A-Fa-f]{6}).*/\1 \2/')"

slots="base00 base01 base02 base03 base04 base05 base06 base07 \
base08 base09 base0a base0b base0c base0d base0e base0f"
while read -r key hex; do
  [ -n "$key" ] || continue
  key="$(printf '%s' "$key" | tr 'A-F' 'a-f')"
  printf -v "base_$key" '%s' "#$hex"
done <<EOF
$pairs
EOF

for slot in $slots; do
  var="base_${slot#base}"
  if [ -z "${!var:-}" ]; then
    printf 'tinty/generate: %s 缺少 %s，跳过生成\n' "$scheme_id" "$slot" >&2
    exit 1
  fi
done

# 明暗判定与语义强调槽 c_emph：base07 并非可靠的强调色——kissa-latte 等
# 浅色 scheme 的 base07 是 bright white，fg/bg 用它会出现白字白底；base16
# 规范中 base05 恒为主前景、与 base00 强对比，故浅色 scheme 的强调色
# （边框/标题/目录名/mode 等底块）取 base05，深色 scheme 维持 base07
# （与原始 lavender 语义一致，深色产物逐字节不变）。
luma() {
  local hex="${1#\#}" r g b
  r=$((16#${hex:0:2})) g=$((16#${hex:2:2})) b=$((16#${hex:4:2}))
  printf '%s' $(( (2126*r + 7152*g + 722*b) / 10000 ))
}
if [ "$(luma "$base_00")" -gt "$(luma "$base_05")" ]; then
  c_emph="$base_05"
else
  c_emph="$base_07"
fi

render() {
  local out="$1" tmpl="$2" args=() slot suffix upper var
  for slot in $slots; do
    suffix="${slot#base}"
    upper="$(printf '%s' "$suffix" | tr 'a-f' 'A-F')"
    var="base_$suffix"
    args+=(-e "s|{{base${upper}}}|${!var}|g" -e "s|{{${slot}}}|${!var}|g")
  done
  args+=(-e "s|{{scheme_id}}|$scheme_id|g" -e "s|{{c_emph}}|$c_emph|g")
  sed "${args[@]}" "$tmpl" > "$out"
}

for flavor_dir in $flavor_dirs; do
  mkdir -p "$flavor_dir"
  render "$flavor_dir/flavor.toml" "$SCRIPT_DIR/yazi-flavor.template"
  render "$flavor_dir/tmtheme.xml" "$SCRIPT_DIR/yazi-tmtheme.template"
done
mkdir -p "$(dirname "$glow_style")"
render "$glow_style" "$SCRIPT_DIR/glow.template"
mkdir -p "$(dirname "$lazygit_overlay")"
render "$lazygit_overlay" "$SCRIPT_DIR/lazygit.template"
mkdir -p "$ghdash_dir"
render "$ghdash_theme" "$SCRIPT_DIR/gh-dash.template"
# repo 上下文组合版：拼接源优先 live repo-context.yml（尊重本地未受管
# 自定义），回退仓库受管副本；两者皆缺则跳过（gd 回退 repo-context.yml
# 原路径）。printf 分隔行兜底无尾换行的拼接源。
ghdash_ctx_src="$ghdash_dir/repo-context.yml"
if [ ! -r "$ghdash_ctx_src" ]; then
  ghdash_ctx_src="$SCRIPT_DIR/../../home/.config/gh-dash/repo-context.yml"
fi
if [ -r "$ghdash_ctx_src" ]; then
  { cat "$ghdash_ctx_src"; printf '\n'; cat "$ghdash_theme"; } > "$ghdash_context"
fi
printf 'tinty/generate: %s -> %s + %s + %s + %s\n' "$scheme_id" "$flavor_dirs" "$glow_style" "$lazygit_overlay" "$ghdash_theme" >&2
