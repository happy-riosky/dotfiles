#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${DOTFILES_ROOT:-$SCRIPT_ROOT}"
# shellcheck source=scripts/lib-dotfiles.sh
source "$SCRIPT_ROOT/scripts/lib-dotfiles.sh"

PROFILE="${1:-}"
[[ -n "$PROFILE" ]] || { printf 'usage: ./install {full|server|termux} [--dry-run]\n' >&2; exit 2; }
shift

DRY_RUN=0
if [[ "${1:-}" == --dry-run ]]; then
  DRY_RUN=1
  shift
fi
[[ $# -eq 0 ]] || { printf 'install: unsupported option: %s\n' "$1" >&2; exit 2; }

PLATFORM="$(dotfiles_platform)"
validate_platform_profile "$PLATFORM" "$PROFILE" install

export DOTFILES_ROOT="$ROOT" DOTFILES_PLATFORM="$PLATFORM" DOTFILES_PROFILE="$PROFILE"
if (( DRY_RUN == 1 )); then
  "$SCRIPT_ROOT/scripts/link" --dry-run
else
  "$SCRIPT_ROOT/scripts/link"
fi
