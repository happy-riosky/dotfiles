{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin-frappe-yellow",
  "plugin": [
    "./tui-plugins/tinty-theme.js"
  ],
  "vim": true,
  "vim_modal_input": true,
  "vim_system_clipboard_register": true,
  "keybinds": {
    "input_newline": "shift+enter",
    "session_pin_toggle": "none",
    "session_rename": "none",
    "session_delete": "none",
    "vim.normal": {
      "session_rename": "shift+r",
      "session_pin_toggle": "p",
      "session_delete": "d",
    }
  }
}
