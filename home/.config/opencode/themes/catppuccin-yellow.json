    "markdownLink": {
      "dark": "mocBlue",
      "light": "latBlue"
    },
    "markdownLinkText": {
      "dark": "mocSky",
      "light": "latSky"
    },
    "markdownCode": {
      "dark": "mocGreen",
      "light": "latGreen"
    },
    "markdownBlockQuote": {
      "dark": "mocYellow",
      "light": "latYellow"
    },
    "markdownEmph": {
      "dark": "mocYellow",
      "light": "latYellow"
    },
    "markdownStrong": {
      "dark": "mocPeach",
      "light": "latPeach"
