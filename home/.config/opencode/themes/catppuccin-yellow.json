      "light": "latBlue"
    },
    "markdownImageText": {
      "dark": "mocSky",
      "light": "latSky"
    },
    "markdownCodeBlock": {
      "dark": "mocText",
      "light": "latText"
    },
    "syntaxComment": {
      "dark": "mocOverlay2",
      "light": "latOverlay2"
    },
    "syntaxKeyword": {
      "dark": "mocAccent",
      "light": "latAccent"
