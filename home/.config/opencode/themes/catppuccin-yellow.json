  "theme": {
    "primary": {
      "dark": "mocAccent",
      "light": "latAccent"
    },
    "secondary": {
      "dark": "mocAccent",
      "light": "latAccent"
    },
    "accent": {
      "dark": "mocPink",
      "light": "latBlue"
    },
    "error": {
      "dark": "mocRed",
      "light": "latRed"
    },
    "warning": {
      "dark": "mocYellow",
      "light": "latYellow"
    },
    "success": {
      "dark": "mocGreen",
      "light": "latGreen"
