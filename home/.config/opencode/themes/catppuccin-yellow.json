    "syntaxFunction": {
      "dark": "mocBlue",
      "light": "latBlue"
    },
    "syntaxVariable": {
      "dark": "mocRed",
      "light": "latRed"
    },
    "syntaxString": {
      "dark": "mocGreen",
      "light": "latGreen"
    },
    "syntaxNumber": {
      "dark": "mocPeach",
      "light": "latPeach"
    },
    "syntaxType": {
      "dark": "mocYellow",
      "light": "latYellow"
    },
    "syntaxOperator": {
      "dark": "mocSky",
      "light": "latSky"
    },
    "syntaxPunctuation": {
      "dark": "mocText",
      "light": "latText"
    }
