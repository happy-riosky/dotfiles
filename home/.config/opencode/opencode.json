{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/var/folders/*/*/T/opencode/**": "allow",
      "/private/var/folders/*/*/T/opencode/**": "allow",
      "~/.cache/opencode/tmp/**": "allow",
      "~/.agents/personal-harness/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.opencode/skills/**": "allow"
    }
  },
  "model": "pytrio/glm-5.2",
  "provider": {
    "pytrio": {
      "name": "pytrio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://newapi.pytrio.asia/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "options": {
            "reasoningEffort": "high"
          }
        },
        "gemini-3.1-pro-high": {
          "name": "gemini-3.1-pro-high",
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "grok-4.5": {
          "name": "grok-4.5",
          "options": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "grok-4.6": {
          "name": "grok-4.6",
          "options": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "glm-5.2": {
          "name": "glm-5.2",
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "options": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "include": ["reasoning.encrypted_content"]
            }
          }
        }
      }
    }
  }
}
